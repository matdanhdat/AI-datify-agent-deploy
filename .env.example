# Google Gemini API Keys (Server-side / Vercel Environment Variables ONLY — NEVER commit real keys!)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Primary and Fallback Models (Google Gemini 3 series)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.8-flash

# Thinking Level Configuration (minimal, low, medium, high)
# Fast tasks (ping, explain_cleaning, chat_explain, plan_custom, business_insights): minimal
GEMINI_THINKING_LEVEL=minimal
# Structured long report (write_report): low
GEMINI_THINKING_LEVEL_REPORT=low

# Feature Flag / Instant Rollback Switch for M3 Business Analysis Engine
# Set to 1 to revert Step 3/4 Business Analysis to legacy fallback immediately without redeploying code
VITE_DISABLE_M3_ANALYSIS=0
